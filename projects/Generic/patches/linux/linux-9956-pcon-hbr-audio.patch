+void snd_hdac_acomp_wait_vblank(struct hdac_device *codec, hda_nid_t nid,
+				int dev_id)
+{
+	struct hdac_bus *bus = codec->bus;
+	struct drm_audio_component *acomp = bus->audio_component;
+	int port;
+
+	if (!acomp || !acomp->ops || !acomp->ops->wait_vblank)
+		return;
+	port = nid;
+	if (acomp->audio_ops && acomp->audio_ops->pin2port) {
+		port = acomp->audio_ops->pin2port(codec, nid);
+		if (port < 0)
+			return;
+	}
+	acomp->ops->wait_vblank(acomp->dev, port, dev_id);
+}
+EXPORT_SYMBOL_GPL(snd_hdac_acomp_wait_vblank);
