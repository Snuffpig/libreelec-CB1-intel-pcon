+static bool intel_audio_is_cm11_pcon(struct intel_display *display)
+{
+	const char *board;
+
+	if (!display->params.dv_pcon)
+		return false;
+	if (display->params.dv_pcon > 0)
+		return true;
+
+	board = dmi_get_system_info(DMI_BOARD_NAME);
+	return board && strstr(board, "CM11EB");
+}
+
+static bool tgl_audio_fault_latched(struct intel_display *display, u32 *status_out)
+{
+	u32 val;
+
+	if (!intel_audio_is_cm11_pcon(display) || DISPLAY_VER(display) != 12)
+		return false;
+
+	val = intel_de_read(display, TGL_AUD_BE_FAULT_STATUS);
+	if (status_out)
+		*status_out = val;
+
+	return val && (val & TGL_AUD_BE_FAULT_LATCHED);
+}
+
+static void intel_audio_power_enable(struct intel_display *display, bool pulse_wake);
