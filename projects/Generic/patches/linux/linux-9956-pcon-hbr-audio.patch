+static void intel_audio_fault_check_work(struct work_struct *work)
+{
+	struct intel_display *display =
+		container_of(to_delayed_work(work), struct intel_display,
+			     audio.fault_check_work);
+	struct i915_audio_component *acomp = display->audio.component;
+	struct ref_tracker *wakeref;
+	u32 val = 0, post_val = 0;
+	bool latched;
+
+	if (!intel_audio_is_cm11_pcon(display) || DISPLAY_VER(display) != 12 ||
+	    !display->audio.component_registered)
+		return;
+
+	wakeref = intel_display_power_get_if_enabled(display, POWER_DOMAIN_AUDIO_MMIO);
+	if (!wakeref)
+		return;
+
+	latched = tgl_audio_fault_latched(display, &val);
+	intel_display_power_put(display, POWER_DOMAIN_AUDIO_MMIO, wakeref);
+	if (!latched) {
+		display->audio.fault_retry_count = 0;
+		return;
+	}
+
+	if (display->audio.fault_retry_count >= 2) {
+		drm_dbg_kms(display->drm,
+			    "Gen12 display audio fault still present (0x65f20=0x%08x), retry limit reached\n",
+			    val);
+		return;
+	}
+
+	if (display->audio.last_fault_recovery &&
+	    time_before(jiffies, display->audio.last_fault_recovery + msecs_to_jiffies(10000))) {
+		drm_dbg_kms(display->drm,
+			    "Gen12 display audio fault still present (0x65f20=0x%08x), cooldown active\n",
+			    val);
+		return;
+	}
+	display->audio.last_fault_recovery = jiffies;
+	display->audio.fault_retry_count++;
+
+	drm_warn(display->drm,
+		 "Gen12 display audio fault latched (0x65f20=0x%08x); power-cycling display to resync (attempt %u/2)\n",
+		 val, display->audio.fault_retry_count);
+
+	intel_display_reset_prepare(display);
+	if (acomp && acomp->base.audio_ops &&
+	    acomp->base.audio_ops->bus_reset_notify)
+		acomp->base.audio_ops->bus_reset_notify(acomp->base.audio_ops->audio_ptr,
+							0);
+	{
+		struct ref_tracker *aud_wakeref;
+
+		mutex_lock(&display->audio.mutex);
+		aud_wakeref = display->audio.wakeref;
+		display->audio.wakeref = NULL;
+		mutex_unlock(&display->audio.mutex);
+		if (aud_wakeref)
+			intel_display_power_put(display, POWER_DOMAIN_AUDIO_PLAYBACK,
+						aud_wakeref);
+	}
+	intel_display_power_flush_work(display);
+	msleep(400);
+	mutex_lock(&display->audio.mutex);
+	if (display->audio.power_refcount > 0)
+		intel_audio_power_enable(display, true);
+	mutex_unlock(&display->audio.mutex);
+	if (acomp && acomp->base.audio_ops &&
+	    acomp->base.audio_ops->bus_reset_notify)
+		acomp->base.audio_ops->bus_reset_notify(acomp->base.audio_ops->audio_ptr,
+							1);
+	intel_display_reset_finish(display, true);
+	if (acomp && acomp->base.audio_ops &&
+	    acomp->base.audio_ops->bus_reset_notify)
+		acomp->base.audio_ops->bus_reset_notify(acomp->base.audio_ops->audio_ptr,
+							2);
+
+	msleep(50);
+	wakeref = intel_display_power_get_if_enabled(display, POWER_DOMAIN_AUDIO_MMIO);
+	if (wakeref) {
+		tgl_audio_fault_latched(display, &post_val);
+		intel_display_power_put(display, POWER_DOMAIN_AUDIO_MMIO, wakeref);
+	}
+	drm_info(display->drm,
+		 "Gen12 display audio resync complete (0x65f20=0x%08x)\n",
+		 post_val);
+}
