+static void intel_bus_reset_notify(void *audio_ptr, int stage)
+{
+	struct hda_codec *codec = audio_ptr;
+	struct hdac_bus *bus = &codec->bus->core;
+	struct hdmi_spec *spec = codec->spec;
+	struct hda_pcm *pcm;
+	int i;
+
+	if (stage == 0) {
+		mutex_lock(&bus->cmd_mutex);
+		snd_hdac_bus_stop_chip(bus);
+		return;
+	}
+
+	if (stage == 1) {
+		snd_hdac_i915_set_bclk(bus);
+		snd_hdac_bus_init_chip(bus, true);
+		mutex_unlock(&bus->cmd_mutex);
+		return;
+	}
+
+	for (i = 0; i < spec->num_pins; i++) {
+		struct hdmi_spec_per_pin *per_pin = get_pin(spec, i);
+
+		scoped_guard(mutex, &per_pin->lock) {
+			per_pin->hw_state_valid = false;
+			per_pin->defer_unmute = false;
+		}
+	}
+
+	if (codec->core.regmap)
+		regcache_mark_dirty(codec->core.regmap);
+
+	if (spec->vendor_nid) {
+		intel_haswell_enable_all_pins(codec, false);
+		intel_haswell_fixup_enable_dp12(codec);
+	}
+
+	if (codec->core.afg) {
+		snd_hda_codec_write(codec, codec->core.afg, 0,
+				    AC_VERB_SET_POWER_STATE, AC_PWRST_D0);
+		msleep(10);
+		snd_hda_codec_set_power_to_all(codec, codec->core.afg, AC_PWRST_D0);
+	}
+	i915_hdmi_resume(codec);
+
+	list_for_each_entry(pcm, &codec->pcm_list_head, list) {
+		struct snd_pcm_substream *substream;
+
+		if (!pcm->pcm)
+			continue;
+		for (substream = pcm->pcm->streams[SNDRV_PCM_STREAM_PLAYBACK].substream;
+		     substream; substream = substream->next)
+			snd_pcm_stop_xrun(substream);
+	}
+}
