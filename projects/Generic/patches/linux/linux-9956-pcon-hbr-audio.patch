+static void intel_audio_component_wait_vblank(struct device *kdev, int port,
+					      int cpu_transcoder)
+{
+	struct intel_display *display = to_intel_display(kdev);
+	const struct intel_audio_state *audio_state;
+	struct intel_encoder *encoder;
+	struct intel_crtc *crtc;
+	unsigned long cookie;
+
+	if (!intel_audio_is_cm11_pcon(display) || !HAS_DDI(display))
+		return;
+
+	cookie = intel_audio_component_get_power(kdev);
+	mutex_lock(&display->audio.mutex);
+
+	audio_state = find_audio_state(display, port, cpu_transcoder);
+	if (!audio_state)
+		goto unlock;
+
+	encoder = audio_state->encoder;
+	if (!encoder || !encoder->base.crtc)
+		goto unlock;
+
+	crtc = to_intel_crtc(encoder->base.crtc);
+	if (crtc->active && crtc->config &&
+	    intel_crtc_has_dp_encoder(crtc->config))
+		intel_crtc_wait_for_next_vblank(crtc);
+
+unlock:
+	mutex_unlock(&display->audio.mutex);
+	intel_audio_component_put_power(kdev, cookie);
+}
