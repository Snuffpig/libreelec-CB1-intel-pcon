+void intel_connector_attach_cb1_output_telemetry(struct intel_connector *connector)
+{
+	struct drm_device *drm = connector->base.dev;
+	static const struct drm_prop_enum_list formats[] = {
+		{ 0, "Unknown" },
+		{ 1, "RGB 4:4:4" },
+		{ 2, "YCbCr 4:4:4" },
+		{ 3, "YCbCr 4:2:2" },
+		{ 4, "YCbCr 4:2:0" },
+	};
+
+	if (!connector->cb1_output_format_property) {
+		connector->cb1_output_format_property = drm_property_create_enum(drm,
+			DRM_MODE_PROP_ENUM | DRM_MODE_PROP_IMMUTABLE,
+			"CB1_OUTPUT_FORMAT", formats, ARRAY_SIZE(formats));
+		if (connector->cb1_output_format_property)
+			drm_object_attach_property(&connector->base.base,
+						   connector->cb1_output_format_property, 0);
+	}
+
+	if (!connector->cb1_output_bpc_property) {
+		connector->cb1_output_bpc_property = drm_property_create_range(drm,
+			DRM_MODE_PROP_RANGE | DRM_MODE_PROP_IMMUTABLE,
+			"CB1_OUTPUT_BPC", 0, 16);
+		if (connector->cb1_output_bpc_property)
+			drm_object_attach_property(&connector->base.base,
+						   connector->cb1_output_bpc_property, 0);
+	}
+}
+
+void intel_connector_update_cb1_output_telemetry(struct intel_connector *connector,
+						 const struct intel_crtc_state *crtc_state,
+						 const struct drm_connector_state *conn_state)
+{
+	u64 format = 0;
+	u64 bpc = 0;
+
+	if (!connector || (!connector->cb1_output_format_property && !connector->cb1_output_bpc_property))
+		return;
+
+	if (crtc_state && crtc_state->hw.active) {
+		u8 lldv = conn_state ? to_intel_digital_connector_state(conn_state)->lldv_format : 0;
+
+		if (lldv && lldv != INTEL_LLDV_RGB10) {
+			format = 3;
+		} else {
+			switch (crtc_state->sink_format) {
+			case INTEL_OUTPUT_FORMAT_RGB:
+				format = 1;
+				break;
+			case INTEL_OUTPUT_FORMAT_YCBCR444:
+				format = 2;
+				break;
+			case INTEL_OUTPUT_FORMAT_YCBCR420:
+				format = 4;
+				break;
+			default:
+				format = 0;
+				break;
+			}
+		}
+		bpc = clamp_t(u64, crtc_state->pipe_bpp / 3, 0, 16);
+	}
+
+	if (connector->cb1_output_format_property)
+		drm_object_property_set_value(&connector->base.base,
+					      connector->cb1_output_format_property, format);
+	if (connector->cb1_output_bpc_property)
+		drm_object_property_set_value(&connector->base.base,
+					      connector->cb1_output_bpc_property, bpc);
+}
+
