+static void amdgpu_dm_update_cb1_output_telemetry(struct amdgpu_dm_connector *aconnector,
+						   const struct dc_stream_state *stream)
+{
+	u64 format = 0;
+	u64 bpc = 0;
+
+	if (!aconnector)
+		return;
+
+	if (stream) {
+		switch (stream->timing.pixel_encoding) {
+		case PIXEL_ENCODING_RGB:
+			format = 1;
+			break;
+		case PIXEL_ENCODING_YCBCR444:
+			format = 2;
+			break;
+		case PIXEL_ENCODING_YCBCR422:
+			format = 3;
+			break;
+		case PIXEL_ENCODING_YCBCR420:
+			format = 4;
+			break;
+		default:
+			format = 0;
+			break;
+		}
+
+		switch (stream->timing.display_color_depth) {
+		case COLOR_DEPTH_666:
+			bpc = 6;
+			break;
+		case COLOR_DEPTH_888:
+			bpc = 8;
+			break;
+		case COLOR_DEPTH_101010:
+			bpc = 10;
+			break;
+		case COLOR_DEPTH_121212:
+			bpc = 12;
+			break;
+		case COLOR_DEPTH_141414:
+			bpc = 14;
+			break;
+		case COLOR_DEPTH_161616:
+			bpc = 16;
+			break;
+		default:
+			bpc = 0;
+			break;
+		}
+	}
+
+	if (aconnector->cb1_output_format_property)
+		drm_object_property_set_value(&aconnector->base.base,
+					      aconnector->cb1_output_format_property, format);
+	if (aconnector->cb1_output_bpc_property)
+		drm_object_property_set_value(&aconnector->base.base,
+					      aconnector->cb1_output_bpc_property, bpc);
+}
+
 static void amdgpu_dm_commit_streams(struct drm_atomic_commit *state,
 					struct dc_state *dc_state)
